{
  "name": "lumen-design",
  "private": true,
  "type": "module",
  "version": "1.0.0-beta.8",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "bun run --cwd packages/lumen-ui build",
    "check": "bun run check:theme && bun run lint && bun run typecheck && bun run test && bun run build",
    "check:theme": "bun scripts/check-theme.ts",
    "lint": "eslint eslint.config.js packages/lumen-ui/src packages/lumen-ui/vite.config.ts playground/src playground/vite.config.ts scripts --max-warnings=0",
    "lint:fix": "eslint eslint.config.js packages/lumen-ui/src packages/lumen-ui/vite.config.ts playground/src playground/vite.config.ts scripts --max-warnings=0 --fix",
    "release": "lerna version --no-private",
    "test": "bun run --cwd packages/lumen-ui test",
    "typecheck": "bun run --cwd packages/lumen-ui typecheck",
    "playground": "bun run --cwd playground dev",
    "playground:build": "bun run --cwd playground build"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "lerna": "^10.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
