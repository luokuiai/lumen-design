{
  "name": "@luokuiai/lumen-ui",
  "version": "1.0.0-alpha.4",
  "description": "Lumen UI React component library",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luokuiai/lumen-design.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/lumen-ui.css",
    "./theme-contract": {
      "types": "./dist/types/theme-contract.d.ts",
      "import": "./dist/theme-contract.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.563.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
